# Google Gemini API Configuration (Free tier from Google AI Studio: https://aistudio.google.com/)
GOOGLE_CLOUD_API_KEY=your_gcp_api_key_here
# Optional: Override Gemini Model (defaults to gemini-3.5-flash with fallback)
GEMINI_MODEL=gemini-3.5-flash

# Password to protect the owner reply generator at /admin/reply
ADMIN_PASSWORD=your_admin_password_here

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:5000/api
